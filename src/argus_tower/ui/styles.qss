/* ARGUS TOWER - Modern Dark Stylesheet */

QMainWindow, QWidget {
    background-color: #18181b; /* VS Code style deep dark background */
    color: #e4e4e7;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* Native Menu Bar (Top Panel) */
QMenuBar {
    background-color: #18181b;
    color: #cccccc;
    border-bottom: 1px solid #27272a;
}

QMenuBar::item {
    spacing: 3px;
    padding: 6px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #27272a;
    color: #ffffff;
    border-radius: 4px;
}

QMenu {
    background-color: #27272a;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

/* Sidebar Styles */
#Sidebar {
    background-color: #18181b;
    border-right: 1px solid #27272a;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #a1a1aa;
    border: none;
    border-radius: 4px;
    padding: 10px;
    text-align: left;
    font-weight: bold;
}

#Sidebar QPushButton:hover {
    background-color: #27272a;
    color: #ffffff;
}

#Sidebar QPushButton:checked {
    background-color: #27272a;
    color: #60a5fa;
    border-left: 3px solid #3b82f6;
    border-radius: 0px;
}

/* Tab Widget (Fix for Drone 1 / Drone 2 buttons) */
QTabWidget::pane {
    border: 1px solid #27272a;
    background-color: #18181b;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #18181b;
    color: #a1a1aa;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #ffffff;
    background-color: #27272a;
    border-radius: 4px;
}

QTabBar::tab:selected {
    color: #60a5fa;
    border-bottom: 2px solid #3b82f6;
    font-weight: bold;
}

/* Card / Box Containers */
QGroupBox, .CardWidget {
    background-color: #1f1f22;
    border: 1px solid #27272a;
    border-radius: 6px;
    margin-top: 6px;
    padding: 10px;
}

/* Tables & Lists */
QTableWidget, QListWidget {
    background-color: #1f1f22;
    border: 1px solid #27272a;
    gridline-color: #27272a;
    border-radius: 4px;
    outline: 0;
}

QHeaderView::section {
    background-color: #1f1f22;
    color: #a1a1aa;
    padding: 4px;
    border: 1px solid #27272a;
    font-weight: bold;
}

/* Action Buttons */
QPushButton {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #3f3f46;
}

QPushButton#ApproveBtn {
    background-color: #16a34a;
    border: none;
    font-weight: bold;
}

QPushButton#ApproveBtn:hover {
    background-color: #15803d;
}

QPushButton#RejectBtn {
    background-color: #dc2626;
    border: none;
    font-weight: bold;
}

QPushButton#RejectBtn:hover {
    background-color: #b91c1c;
}

/* Map View Specific Styles */
QFrame#MiniMap {
    background-color: #1f1f22;
    border: 1px solid #27272a;
    border-radius: 6px;
}

QFrame#MiniMap:hover {
    border: 1px solid #3b82f6;
}

QPushButton#MiniMapHeader {
    background-color: transparent;
    color: #a1a1aa;
    font-weight: bold;
    font-size: 11px;
    border: none;
    text-align: center;
    padding: 4px;
}

QPushButton#MiniMapHeader:hover {
    color: #ffffff;
    background-color: #27272a;
    border-radius: 4px;
}